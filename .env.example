# Copy this to .env and fill in real values. .env is gitignored — never commit it.
# quickstart.sh fills in PUID/PGID automatically; the rest you fill in by hand.

# Your host user's uid/gid — containers run as this so bootstrapped secrets
# stay readable without any chown/sudo. Find yours with `id -u` / `id -g`.
PUID=1000
PGID=1000

# Azure AD application (App Registration) credentials.
# The app registration needs:
#   - Microsoft Graph API permission: Application.Read.All
#   - Intune role assignment: scep_challenge_provider
# See README.md "Azure AD / Intune setup" for the exact steps.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000

# Cloudflare Tunnel token — create a tunnel in the Cloudflare Zero Trust
# dashboard (Networks > Tunnels > Create a tunnel), choose "Docker" as the
# connector, and it will give you a token to paste here.
CLOUDFLARE_TUNNEL_TOKEN=

# The public hostname clients will reach pimptune at — must match the Public
# Hostname you map to pimptune:8080 in the Cloudflare Zero Trust dashboard.
# scripts/02-bootstrap-step-ca.sh reads this to bake the right CRL/issuing-cert
# URLs into issued certs. quickstart.sh sources this file before bootstrapping,
# so setting it here is enough — no manual `export` needed.
PUBLIC_HOSTNAME=scep-dev.example.com

# Optional: public hostname for Jamf-managed (or other generic SCEP client)
# enrollment, served directly by step-ca — pimptune only validates
# Intune-enrolled devices, so this is a separate path for anything else.
# Leave blank to skip entirely (default) with no other changes. If set,
# scripts/02-bootstrap-step-ca.sh adds a second, static-challenge SCEP
# provisioner named "jamf" and prints the generated challenge secret. You
# still need to add a matching Cloudflare Tunnel Public Hostname pointing at
# step-ca:9000 (with "No TLS Verify") and configure Jamf's SCEP payload —
# see README.md "Jamf Pro configuration".
JAMF_PUBLIC_HOSTNAME=
